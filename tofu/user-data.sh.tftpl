#!/usr/bin/env bash
#
# What turns a stock Amazon Linux instance into one of our services.
#
# The release is a tarball in the artifacts bucket under a pointer file, rather than an AMI built
# per deploy. Two reasons: an AMI bake adds ten minutes to every deploy and a blue/green cutover is
# supposed to be seconds, and a pointer file makes "what is this instance running" a question with a
# readable answer instead of an AMI id.
set -euo pipefail

exec > >(tee /var/log/sproutos-bootstrap.log) 2>&1

SERVICE="${service}"
BUCKET="${artifacts_bucket}"
REGION="${aws_region}"

dnf install -y awscli tar gzip

# Node, for the website. The router needs nothing.
#
# Amazon Linux 2023 ships no Node at all, and the failure is not subtle once you are on the box —
# `/opt/sproutos/start: line 3: node: command not found`, restarting every two seconds — but from
# outside it is only an Auto Scaling group whose instances never pass a health check. The router
# never surfaced it because a static musl binary has no runtime to be missing.
#
# From nodejs.org rather than `dnf install nodejs`, because the distribution's package is whatever
# major AL2023 chose and the release was built and typechecked against ${node_version}. A Next.js
# standalone server usually tolerates one major either way; "usually" is not a property to hang a
# deploy on when pinning is one URL.
#
# The alternative was to put Node in the release tarball, which makes it hermetic at the cost of
# ~60 MB on every instance launch of an artefact that is already 127 MB. Worth revisiting if boot
# time starts to matter more than transfer.
if [ "$SERVICE" = "website" ]; then
  NODE_VERSION="${node_version}"
  curl -fsSL "https://nodejs.org/dist/v$NODE_VERSION/node-v$NODE_VERSION-linux-arm64.tar.xz" \
    -o /tmp/node.tar.xz
  install -d -m 0755 /opt/node
  tar -xJf /tmp/node.tar.xz -C /opt/node --strip-components=1
  rm -f /tmp/node.tar.xz
  # On PATH for the unit, which runs as a DynamicUser with the default systemd path.
  ln -sf /opt/node/bin/node /usr/local/bin/node
  ln -sf /opt/node/bin/npm /usr/local/bin/npm
fi

install -d -m 0755 /opt/sproutos
install -d -m 0755 /etc/sproutos

# The pointer, not a version baked into this script.
#
# User data is part of the launch template, so a release that edited it would make a new template
# version on every deploy and leave the Auto Scaling group's $Latest racing the cutover. The
# pointer is one small object the deploy writes; the template never changes.
RELEASE=$(aws s3 cp "s3://$BUCKET/releases/$SERVICE/current" - --region "$REGION")

if [ -z "$RELEASE" ]; then
  echo "no release pointer at s3://$BUCKET/releases/$SERVICE/current" >&2
  exit 1
fi

aws s3 cp "s3://$BUCKET/releases/$SERVICE/$RELEASE.tar.gz" /tmp/release.tar.gz --region "$REGION"
tar -xzf /tmp/release.tar.gz -C /opt/sproutos
rm -f /tmp/release.tar.gz

# Recorded where an operator looking at a misbehaving instance will find it, and where the health
# check can be made to report it later.
echo "$RELEASE" > /etc/sproutos/release

# The instance's own configuration, read by both services. Secrets are not here — they are fetched
# at start from Secrets Manager under the instance role.
cat > /etc/sproutos/env <<ENVFILE
AWS_REGION=$REGION
VALKEY_URL=${valkey_url}
TENANT_DOMAIN=${tenant_domain}
ROUTER_PORT=8080
PORT=8080
API_PORT=3001
# Not secrets, and not optional either.
#
# `NEXT_PUBLIC_HOST_URL` is what `lib/typescript/oauth/src/github.ts` builds the OAuth redirect URI
# from, and it is read through `requireEnv` — absent, the login route throws before it reaches
# GitHub. It has to be the *one* host the OAuth App has registered, because GitHub compares the
# redirect it is sent against the one on the application.
NEXT_PUBLIC_HOST_URL=https://${tenant_domain}
NEXT_PUBLIC_API_URL=https://api.${tenant_domain}
ENVFILE

# The database URL, composed here from the secret RDS manages rather than written into the launch
# template.
#
# `manage_master_user_password` means no password is ever in `terraform.tfstate`, and the price of
# that is this: the value only exists in Secrets Manager, so something has to fetch it at boot. The
# router does not need it and does not get it — `${service}` is the whole condition.
if [ "$SERVICE" = "website" ]; then
  SECRET=$(aws secretsmanager get-secret-value \
    --secret-id "${database_secret_arn}" --query SecretString --output text --region "$REGION")

  DB_USER=$(echo "$SECRET" | python3 -c 'import json,sys; print(json.load(sys.stdin)["username"])')
  DB_PASS=$(echo "$SECRET" | python3 -c 'import json,sys; import urllib.parse; print(urllib.parse.quote(json.load(sys.stdin)["password"], safe=""))')

  # Percent-encoded above, because an RDS-generated password may contain characters that are
  # delimiters in a URL. An unencoded `/` or `@` produces a connection string that parses into a
  # different host entirely, and the error names the wrong thing.
  echo "DATABASE_URL=postgresql://$DB_USER:$DB_PASS@${database_endpoint}/${database_name}?sslmode=require" >> /etc/sproutos/env

  # Amazon's RDS certificate authority, because Node does not ship it.
  #
  # `sslmode=require` gets a TLS connection and node-postgres still verifies the chain, so without
  # this the API connects, fails verification, and reports itself unready with "self-signed
  # certificate in certificate chain" — which sounds like a misconfigured database and is really a
  # missing root.
  #
  # The alternative people reach for is `rejectUnauthorized: false`, which makes the error go away
  # by removing the only thing TLS was doing here: the connection would still be encrypted and would
  # no longer be authenticated. The global bundle covers every region and rotation, and is one
  # download.
  curl -fsSL https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
    -o /etc/sproutos/rds-ca.pem
  chmod 0644 /etc/sproutos/rds-ca.pem
  echo "NODE_EXTRA_CA_CERTS=/etc/sproutos/rds-ca.pem" >> /etc/sproutos/env

fi


# The application's own secrets, from one Parameter Store path — see `app-secrets.tf` for why this
# is Parameter Store and not Secrets Manager.
#
# Takes the keys to write, because the two services do not need the same ones. The website is the
# only thing that talks to GitHub and Stripe; the router only needs what it verifies log tokens and
# reaches Kafka with. One instance role covers both, so this is not a privilege boundary — but a
# credential that is never written to a host is a credential that cannot leak from it, and the
# narrower list costs nothing.
#
# Without these the site boots, serves its landing page, and answers 500 on the first request that
# needs one — "Missing required environment variable: GITHUB_OAUTH_CLIENT_ID" from the login route,
# which is a failure a health check on `/healthz` cannot see because the process is fine.
#
# `get-parameters-by-path` returns at most ten parameters per page, and there are more than ten. The
# AWS CLI follows `NextToken` by itself, so this one call really does return all of them — but that
# is the CLI's doing, not the API's: `--no-paginate` here, or the same call from an SDK without a
# paginator, would silently deliver the first ten and the rest would surface as a 500 from whichever
# route happened to need the eleventh.
write_app_secrets() {
  WANTED="$1"
  APP_PARAMS=$(aws ssm get-parameters-by-path \
    --path "${application_parameter_path}" --recursive --with-decryption \
    --query 'Parameters[].[Name,Value]' --output json --region "$REGION")

  WANTED="$WANTED" python3 - "${application_parameter_path}" "$APP_PARAMS" >> /etc/sproutos/env <<'PYTHON'
import json, os, sys

prefix = sys.argv[1].rstrip("/") + "/"
wanted = os.environ["WANTED"].split()

for name, value in json.loads(sys.argv[2]):
    key = name[len(prefix):] if name.startswith(prefix) else name.rsplit("/", 1)[-1]
    if wanted and key not in wanted:
        continue
    # Single-quoted, with newlines escaped rather than written through.
    #
    # systemd's `EnvironmentFile` has no line continuation: a real newline in a value ends the
    # assignment, so a PEM would arrive as its first line and OpenSSL would report
    # "DECODER routines::unsupported" from inside a signing call ten frames down.
    # `githubAppConfigFromEnv` accepts the `\n`-escaped form and un-escapes it, which is the same
    # shape a PEM takes in a single-line `.env` — so this is the format the application already
    # expects rather than a workaround invented here.
    #
    # The quotes are what make that unambiguous. systemd parses unquoted and double-quoted values
    # with shell-like rules and interprets backslash escapes in them, so a bare `\n` would be turned
    # back into the newline this is trying to avoid. Inside single quotes nothing is interpreted, so
    # the two characters arrive as two characters. Only the newline is escaped and backslashes are
    # left alone, because `replaceAll("\\n", "\n")` on the reading side is exactly that one
    # substitution and nothing else.
    #
    # A value containing a single quote cannot be written this way and is refused rather than
    # silently mangled. None of the credentials this carries has one.
    if "'" in value:
        raise SystemExit(f"{key} contains a single quote, which cannot be written to the env file")
    print(f"{key}='" + value.replace("\n", "\\n") + "'")
PYTHON
}

# The website and API talk to GitHub, Stripe and the signer, and publish the log token onto every
# tenant Lambda. An empty list would mean "everything under the path", which is what this used to
# do; naming them means a key added for some future service does not silently appear here too.
if [ "$SERVICE" = "website" ]; then
  write_app_secrets "GITHUB_OAUTH_CLIENT_ID GITHUB_OAUTH_CLIENT_SECRET GITHUB_APP_ID \
    GITHUB_APP_CLIENT_ID GITHUB_APP_CLIENT_SECRET GITHUB_APP_PRIVATE_KEY GITHUB_WEBHOOK_SECRET \
    STRIPE_PUBLIC_KEY STRIPE_SECRET_KEY STRIPE_WEBHOOK_SECRET APK_SIGNER_TOKEN \
    DEPLOY_TOKEN_SECRET LOG_TOKEN_SECRET SPROUTOS_LOG_ENDPOINT"
fi

# The router verifies the per-project log token the extension presents and holds the Kafka
# connection open. `LOG_TOKEN_SECRET` has to be the *same* value the website stamps onto tenant
# functions — the router recomputes the token from it, so a mismatch rejects every log line with a
# 401 and the pipeline goes quiet without erroring anywhere a person would look.
if [ "$SERVICE" = "router" ]; then
  write_app_secrets "LOG_TOKEN_SECRET KAFKA_BROKERS KAFKA_SASL_USERNAME KAFKA_SASL_PASSWORD"
fi

chmod 0640 /etc/sproutos/env

cat > /etc/systemd/system/sproutos.service <<'UNIT'
[Unit]
Description=SproutOS service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/sproutos/env
ExecStart=/opt/sproutos/start
Restart=always
RestartSec=2

# The service is the only thing on the box that matters, and it is reachable from the internet
# through the ALB. None of these cost anything and each removes a way a compromise becomes
# persistence.
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# A home directory, because a dynamic user does not have one and something in the bundle wants one.
#
# `DynamicUser` allocates a uid with no passwd entry and `ProtectHome` hides /home and /root, so
# `os.homedir()` fails outright — `uv_os_homedir returned ENOENT` — and it is called at *import*
# time by the Claude agent SDK, which esbuild inlines into the API bundle. The process dies before
# any of its own code runs, and the message names neither the SDK nor the sandboxing.
#
# `StateDirectory` is the right answer rather than `HOME=/tmp`: systemd creates it, chowns it to the
# dynamic uid and keeps it across restarts, so anything that writes a cache there is not writing to
# a directory that vanishes.
StateDirectory=sproutos
Environment=HOME=/var/lib/sproutos

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now sproutos.service

# Fail the instance rather than let it join the target group dead. The ALB would work this out from
# its health checks in about forty-five seconds; exiting non-zero here means the Auto Scaling group
# replaces it instead of leaving a permanently unhealthy instance in the rotation.
for _ in $(seq 1 30); do
  if curl -fsS "http://127.0.0.1:8080/healthz" >/dev/null 2>&1; then
    echo "$SERVICE is serving release $RELEASE"
    exit 0
  fi
  sleep 2
done

echo "$SERVICE did not answer /healthz within 60s" >&2
exit 1
