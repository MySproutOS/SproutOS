#!/usr/bin/env bash
#
# What turns a stock Amazon Linux instance into one of our services.
#
# The release is a tarball in the artifacts bucket under a pointer file, rather than an AMI built
# per deploy. Two reasons: an AMI bake adds ten minutes to every deploy and a blue/green cutover is
# supposed to be seconds, and a pointer file makes "what is this instance running" a question with a
# readable answer instead of an AMI id.
set -euo pipefail

exec > >(tee /var/log/sproutos-bootstrap.log) 2>&1

SERVICE="${service}"
BUCKET="${artifacts_bucket}"
REGION="${aws_region}"

# `git` is not optional and is not obvious.
#
# Amazon Linux 2023 ships without it, and the agent shells out to `git clone` to make the checkout it
# works in — so every agent turn failed with `spawn git ENOENT`, a message that names a missing
# binary and says nothing about which one the *product* needed. Nothing else on the instance uses
# git, which is exactly why its absence went unnoticed until an agent run was attempted in
# production for the first time.
dnf install -y awscli tar gzip git

# Node, for the website. The router needs nothing.
#
# Amazon Linux 2023 ships no Node at all, and the failure is not subtle once you are on the box —
# `/opt/sproutos/start: line 3: node: command not found`, restarting every two seconds — but from
# outside it is only an Auto Scaling group whose instances never pass a health check. The router
# never surfaced it because a static musl binary has no runtime to be missing.
#
# From nodejs.org rather than `dnf install nodejs`, because the distribution's package is whatever
# major AL2023 chose and the release was built and typechecked against ${node_version}. A Next.js
# standalone server usually tolerates one major either way; "usually" is not a property to hang a
# deploy on when pinning is one URL.
#
# The alternative was to put Node in the release tarball, which makes it hermetic at the cost of
# ~60 MB on every instance launch of an artefact that is already 127 MB. Worth revisiting if boot
# time starts to matter more than transfer.
if [ "$SERVICE" = "website" ]; then
  NODE_VERSION="${node_version}"
  curl -fsSL "https://nodejs.org/dist/v$NODE_VERSION/node-v$NODE_VERSION-linux-arm64.tar.xz" \
    -o /tmp/node.tar.xz
  install -d -m 0755 /opt/node
  tar -xJf /tmp/node.tar.xz -C /opt/node --strip-components=1
  rm -f /tmp/node.tar.xz
  # On PATH for the unit, which runs as a DynamicUser with the default systemd path.
  ln -sf /opt/node/bin/node /usr/local/bin/node
  ln -sf /opt/node/bin/npm /usr/local/bin/npm
fi

install -d -m 0755 /opt/sproutos
install -d -m 0755 /etc/sproutos

# The pointer, not a version baked into this script.
#
# User data is part of the launch template, so a release that edited it would make a new template
# version on every deploy and leave the Auto Scaling group's $Latest racing the cutover. The
# pointer is one small object the deploy writes; the template never changes.
RELEASE=$(aws s3 cp "s3://$BUCKET/releases/$SERVICE/current" - --region "$REGION")

if [ -z "$RELEASE" ]; then
  echo "no release pointer at s3://$BUCKET/releases/$SERVICE/current" >&2
  exit 1
fi

aws s3 cp "s3://$BUCKET/releases/$SERVICE/$RELEASE.tar.gz" /tmp/release.tar.gz --region "$REGION"
tar -xzf /tmp/release.tar.gz -C /opt/sproutos
rm -f /tmp/release.tar.gz

# Recorded where an operator looking at a misbehaving instance will find it, and where the health
# check can be made to report it later.
echo "$RELEASE" > /etc/sproutos/release

# The instance's own configuration, read by both services. Secrets are not here — they are fetched
# at start from Secrets Manager under the instance role.
cat > /etc/sproutos/env <<ENVFILE
AWS_REGION=$REGION
VALKEY_URL=${valkey_url}
# Where *customer* applications are served from — not where the control plane lives.
#
# These were one value, which worked only because they were the same domain. They are different
# things: this one appears in hostnames we hand to strangers, the other scopes our session cookie.
# Conflating them meant a tenant hostname was one wildcard away from the apex that authenticates
# our own users.
TENANT_DOMAIN=${tenant_domain}

# The HTTPS listener a customer domain's certificate is attached to.
#
# Read by the custom-domain route when a domain verifies. Absent, that route refuses to mark the
# domain active — see its comment — rather than activating one that cannot serve HTTPS.
TENANT_LISTENER_ARN=${tenant_listener_arn}

# The Lambda Web Adapter layer version, for customer builds that are HTTP servers.
#
# A version number rather than a full ARN because the account (753240598075) is AWS's own and the
# region is this one; \`webAdapterLayerArn\` composes them. Pinned rather than tracking latest: a
# layer version is the adapter's *code*, and every customer function published after a bump would
# silently move to it.
#
# Not a secret — it is a public layer, and every published function's configuration names it.
LAMBDA_WEB_ADAPTER_LAYER_VERSION=${lambda_web_adapter_layer_version}

# The account, for reconstructing a project's Lambda alias ARN when republishing routes. Not a
# secret; it is in every ARN this instance already holds.
AWS_ACCOUNT_ID=${aws_account_id}
ROUTER_PORT=8080
# The LLM proxy's port, matching \`aws_lb_target_group.llm\`. Unset, \`listeners::llm\` returns without
# binding — which is the right behaviour for a router that has no proxy secret, and the wrong one
# here: it would start, pass its own health check on the other listeners, and answer nothing on this
# target group. The load balancer would then report the target unhealthy rather than the feature
# missing.
LLM_PROXY_LISTEN=0.0.0.0:8788
# systemd creates and owns \`/var/lib/sproutos\` through \`StateDirectory=sproutos\` below. Metering
# records live there so a router process or service restart cannot erase an unacknowledged bill.
LLM_PROXY_METERING_SPOOL_DIR=/var/lib/sproutos/llm-metering
# Site reports and response egress use their own source and spool so delivery cannot combine them
# with model events. The parent state directory persists across process and service restarts.
SITE_METERING_SPOOL_DIR=/var/lib/sproutos/site-metering
# Search query observations and hourly primary-storage samples are isolated from the other
# emitters, while remaining on the router's persistent state volume.
SEARCH_METERING_SPOOL_DIR=/var/lib/sproutos/search-metering
# Daytona reaches this listener through \`egress.<domain>\` on the tenant NLB. TLS terminates there;
# the router receives the authenticated HTTP forward-proxy protocol on this private instance port.
FORWARD_PROXY_LISTEN=0.0.0.0:3128
PORT=8080
API_PORT=3001
# Not secrets, and not optional either.
#
# \`NEXT_PUBLIC_HOST_URL\` is what \`lib/typescript/oauth/src/github.ts\` builds the OAuth redirect URI
# from, and it is read through \`requireEnv\` — absent, the login route throws before it reaches
# GitHub. It has to be the *one* host the OAuth App has registered, because GitHub compares the
# redirect it is sent against the one on the application.
NEXT_PUBLIC_HOST_URL=https://${control_plane_domain}
NEXT_PUBLIC_API_URL=https://api.${control_plane_domain}

# Where a sandbox reaches the LLM proxy. Read by the chat route and by sandbox provisioning, and it
# goes into the sandbox's environment — so it has to be the address as seen from *outside* this VPC,
# which is the load balancer, not the router's own port.
#
# There is a default in the code (\`https://llm.sproutos.me\`) and it was a hostname nothing served:
# no listener rule, no target group, no \`LLM_PROXY_LISTEN\`. Set here so the value comes from the
# deployment that owns the domain rather than from a constant that happened to be written first.
LLM_PROXY_URL=https://${llm_subdomain}.${control_plane_domain}
SANDBOX_FORWARD_PROXY_URL=https://${egress_subdomain}.${control_plane_domain}
METERING_INGEST_URL=https://api.${control_plane_domain}/v1/internal/metering/events

# Separate topics because their failure policies differ: runtime logs may be dropped to protect a
# customer's request, while usage ingest acknowledges only after Kafka has replicated the event.
KAFKA_RUNTIME_LOG_TOPIC=runtime-logs
KAFKA_USAGE_EVENT_TOPIC=usage-events

# The key \`@lib/envelope\` wraps data keys with.
#
# An ARN identifies a key; it is not one, and holding it grants nothing — the instance can use this
# key only because its role says so, which is why this sits in plain text beside the ports rather
# than in Parameter Store.
#
# Absent, every route that stores an encrypted value throws \`MissingKeyError: No KMS key configured\`
# at the moment it tries — which for the GitHub callback is *after* the OAuth round trip has
# succeeded, so the failure looks like a broken login rather than missing configuration.
KMS_KEY_ID=${envelope_kms_key_arn}

# Where \`proxy.ts\` fetches a SPA's \`index.html\` from.
#
# Unset, \`rewriteToSpa\` falls back to the request's own origin and asks Next.js for
# \`/dashboard/index.html\` — a file the website build does not contain and never will, because the
# dashboard is a separate Vite app. That is a 404 immediately after a successful login, which reads
# as broken authentication rather than a missing rewrite target.
#
# Only the HTML travels this path. The bundles are absolute CloudFront URLs baked in at build time
# by \`VITE_ASSET_BASE\`, so a browser fetches them from the CDN directly instead of routing every
# chunk back through the origin.
SPA_ASSET_ORIGIN=https://${spa_asset_origin}

# The role a tenant's Lambda runs as. \`publish.ts\` falls back to \`""\`, so an unset value is not an
# error — it is a deploy attempted with no execution role, refused by AWS with nothing naming why.
LAMBDA_EXECUTION_ROLE_ARN=${lambda_execution_role_arn}

# The shared bucket tenant static uploads are presigned into, keyed by project id. The code's own
# fallback named a bucket that exists in no account.
TENANT_STATIC_BUCKET=${tenant_static_bucket}
TENANT_ZONE_ID=${tenant_zone_id}
TENANT_STATIC_DISTRIBUTION_DOMAIN=${tenant_static_distribution}
TENANT_STATIC_KEY_VALUE_STORE_ARN=${tenant_static_kvs_arn}

# Where a customer's build archive is uploaded to and where Lambda reads it from.
#
# The same omission \`tenant-static.tf\` describes for the assets bucket, one line down and left
# behind when that one was fixed: \`deploy.ts\` and \`publish.ts\` fall back to \`sproutos-dev-artifacts\`,
# a bucket that exists in no account, so the API signed a PUT for somewhere that is not there and
# the deploy action failed with a bare \`curl: (22) ... 404\` from S3.
#
# Its own bucket rather than the platform's artifacts bucket: that one holds the release this
# instance boots from and the Postgres split's TLS certificate, and accepting customer uploads into
# it would mean granting this role a write on both. See \`tenant-builds.tf\`.
SERVICE_BUILD_BUCKET=${tenant_builds_bucket}

# Runtime logs. An empty \`CLICKHOUSE_URL\` is a feature flag rather than an error: the observability
# client reads it as "not configured" and the logs UI is simply absent. Reached through Traefik on
# the OVH box, whose IP allowlist holds this deployment's NAT egress address — which is why there is
# no port and no credential in the URL.
CLICKHOUSE_URL=https://clickhouse.sproutos.me
CLICKHOUSE_USER=sproutos
CLICKHOUSE_DATABASE=sproutos

# The leading dot is what lets \`api.${control_plane_domain}\` read the session cookie the apex sets, and is
# why the API answers CORS with \`credentials: true\`.
SESSION_COOKIE_DOMAIN=.${control_plane_domain}

# The cluster itself, for the one caller that legitimately names every tenant's indices: the reaper
# that deletes them when a service is deleted.
#
# **Not the proxy, deliberately.** An internal caller has no tenant to be separated from, and the
# proxy exists only to stop one tenant naming another's indices. Routing the reaper through it would
# also be impossible rather than merely wasteful — the proxy authenticates against a tenant secret
# stored as a one-way hash, so the control plane has nothing to present. The same is true of
# \`SERVICE_VALKEY_ADMIN_URL\`, which carries a password and therefore arrives through Parameter Store
# instead of this file.
#
# \`SEARCH_ADMIN_USER\` / \`SEARCH_ADMIN_PASSWORD\` authenticate the reaper to OpenSearch Security's
# internal backend. Tenant requests use separate HMAC-derived internal users.
SEARCH_ADMIN_URL=https://${opensearch_subdomain}.${control_plane_domain}

# What a customer is handed when they provision an Elasticsearch service: the router's search split
# behind the load balancer, on 443, never the cluster.
#
# The distinction is the entire tenancy model rather than a preference. \`docs/findings/0015\` records
# \`SERVICE_POSTGRES_PUBLIC_HOST\` once observed returning the backend's own address to a real caller,
# which is a URI that works and answers to nobody. This is why the code refuses to default it.
SERVICE_SEARCH_PUBLIC_HOST=${search_subdomain}.${control_plane_domain}
SERVICE_SEARCH_PUBLIC_PORT=443

# Tenant S3 clients reach the SigV4-verifying proxy, never the physical bucket. The control plane
# uses the physical bucket only for prefix-scoped teardown; both values come from the infrastructure
# that owns them so neither can drift into a guessed hostname or bucket name.
SERVICE_OBJECT_STORAGE_REGION=$REGION
SERVICE_OBJECT_STORAGE_PUBLIC_ENDPOINT=https://${storage_subdomain}.${control_plane_domain}
SERVICE_OBJECT_STORAGE_SHARED_BUCKET=${tenant_objects_bucket}
SERVICE_OBJECT_STORAGE_PATH_STYLE=true
# Keep provisioning closed during the first, binary-only half of the rollout. The same explicit
# OpenTofu flag that enrolls port 9000 in Auto Scaling health opens the control-plane driver on the
# next website boot, so a service cannot become active while its public endpoint has no targets.
SERVICE_OBJECT_STORAGE_ENABLED=${storage_proxy_enabled}

# The Postgres split, behind the tenant network load balancer. Same rule as search: this is the
# proxy, never the database.
SERVICE_POSTGRES_PUBLIC_HOST=${postgres_subdomain}.${control_plane_domain}
SERVICE_POSTGRES_PUBLIC_PORT=5432

# **\`neon\`, stated rather than left to the default, and this is a safety interlock.**
#
# The default is \`sprout\`, which means "a role and a database on a shared cluster" and takes its
# admin connection from \`SERVICE_POSTGRES_ADMIN_URL ?? DATABASE_URL\`. \`DATABASE_URL\` here is the
# *control plane*. So with the public host set and the provider left alone, provisioning a customer
# database would not fail — it would succeed, by creating a real database and a real role inside the
# RDS instance that holds every organization, session and credit ledger on the platform.
#
# That is the failure this repository keeps writing down: not an error, a working result that is
# wrong. \`sproutPostgresConfigFromEnv\` already refuses to default the *public host* for the same
# class of reason, and this is the other half of it.
#
# \`neon\` has no such fallback. Without \`NEON_API_KEY\` it refuses, the route answers 503 naming the
# variable, and the missing thing is named rather than silently substituted.
SERVICE_POSTGRES_PROVIDER=neon

# The Valkey split, behind the tenant load balancer, which terminates TLS for it — so \`rediss://\`
# is what a customer gets and it is true end to end. The queue this eventually reaches is a
# different name (\`queue.<domain>\`) on purpose: one is the proxy, the other is the shared instance
# behind it, and a customer must never be handed the second.
SERVICE_VALKEY_PUBLIC_HOST=${tenant_valkey_subdomain}.${control_plane_domain}
SERVICE_VALKEY_PUBLIC_PORT=6379
ENVFILE

# The database URL, composed here from the secret RDS manages rather than written into the launch
# template.
#
# `manage_master_user_password` means no password is ever in `terraform.tfstate`, and the price of
# that is this: the value only exists in Secrets Manager, so something has to fetch it at boot.
#
# **Both services now, not just the website.** The router carries the tenant splits, and every one
# of them authenticates a connection by reading `service_credential` out of this database — see
# `lib/rust/service-credentials`. Without it `main.rs` logs "DATABASE_URL is not set; the tenant
# splits are off" and the router serves customer applications while quietly selling no databases,
# which is precisely the state `docs/findings/0015` found production in.
#
# The CA bundle is fetched for both too. Node needs it via `NODE_EXTRA_CA_CERTS`; the Rust store
# needs it via `PGSSLROOTCERT`, and needs it just as badly — `rds.force_ssl` is `1` on
# `default.postgres17`, so an unverified connection is not a weaker connection, it is no connection.
if [ "$SERVICE" = "website" ] || [ "$SERVICE" = "router" ]; then
  SECRET=$(aws secretsmanager get-secret-value \
    --secret-id "${database_secret_arn}" --query SecretString --output text --region "$REGION")

  DB_USER=$(echo "$SECRET" | python3 -c 'import json,sys; print(json.load(sys.stdin)["username"])')
  DB_PASS=$(echo "$SECRET" | python3 -c 'import json,sys; import urllib.parse; print(urllib.parse.quote(json.load(sys.stdin)["password"], safe=""))')

  # Percent-encoded above, because an RDS-generated password may contain characters that are
  # delimiters in a URL. An unencoded `/` or `@` produces a connection string that parses into a
  # different host entirely, and the error names the wrong thing.
  echo "DATABASE_URL=postgresql://$DB_USER:$DB_PASS@${database_endpoint}/${database_name}?sslmode=require" >> /etc/sproutos/env

  # Amazon's RDS certificate authority, because Node does not ship it.
  #
  # `sslmode=require` gets a TLS connection and node-postgres still verifies the chain, so without
  # this the API connects, fails verification, and reports itself unready with "self-signed
  # certificate in certificate chain" — which sounds like a misconfigured database and is really a
  # missing root.
  #
  # The alternative people reach for is `rejectUnauthorized: false`, which makes the error go away
  # by removing the only thing TLS was doing here: the connection would still be encrypted and would
  # no longer be authenticated. The global bundle covers every region and rotation, and is one
  # download.
  curl -fsSL https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
    -o /etc/sproutos/rds-ca.pem
  chmod 0644 /etc/sproutos/rds-ca.pem
  echo "NODE_EXTRA_CA_CERTS=/etc/sproutos/rds-ca.pem" >> /etc/sproutos/env

  # libpq's own name for the same file, which is what the Rust credential store reads. Sharing the
  # variable means `psql` on this host trusts exactly what the proxies trust, so a certificate
  # problem can be reproduced with one command rather than by redeploying.
  echo "PGSSLROOTCERT=/etc/sproutos/rds-ca.pem" >> /etc/sproutos/env

fi

# Where the router's Postgres split asks which Neon endpoint a service belongs to.
#
# The 404 this returns for a suspended service is the enforcement point: Neon wakes a compute on
# connection, so refusing to make the connection is the only thing that stops a suspended database
# from costing money. Plain text because it names an internal address and carries no credential.
if [ "$SERVICE" = "router" ]; then
  echo "PG_PROXY_RESOLVE_URL=https://api.${control_plane_domain}/v1/internal/pg/resolve" >> /etc/sproutos/env

  # The cluster the search split forwards to. The credential for it is a *secret* and arrives
  # through Parameter Store below, because this cluster authenticates nobody itself — see the
  # OpenSearch labels in `ovh/docker-compose.yaml`.
  echo "SEARCH_PROXY_UPSTREAM=https://${opensearch_subdomain}.${control_plane_domain}" >> /etc/sproutos/env
  echo "STORAGE_PROXY_LISTEN=0.0.0.0:9000" >> /etc/sproutos/env
  echo "STORAGE_PROXY_UPSTREAM=https://s3.$REGION.amazonaws.com" >> /etc/sproutos/env
  echo "STORAGE_PROXY_REGION=$REGION" >> /etc/sproutos/env
  echo "STORAGE_PROXY_SHARED_BUCKET=${tenant_objects_bucket}" >> /etc/sproutos/env

  # Optional TLS on the tenant Postgres port.
  #
  # Optional in the sense the protocol means it: a client sends `SSLRequest` before anything else
  # and the server answers `S` or `N`. With a certificate here the answer is `S` and `sslmode=require`
  # works; without one it is `N` and `sslmode=disable` still connects. Nothing is refused either way
  # — Supabase makes the same call, and a tenant whose client cannot do TLS is not a tenant we want
  # to lock out of their own database.
  #
  # This is also why there is no TLS listener on the load balancer for 5432. Postgres negotiates TLS
  # *inside* its own protocol rather than by port, so an NLB cannot terminate it; the certificate has
  # to be here, on the process that speaks the protocol.
  #
  # The two halves come from different places on purpose — see the `tls/*` statement in `compute.tf`.
  if aws s3 cp "s3://$BUCKET/tls/postgres-fullchain.pem" /etc/sproutos/pg-tls-fullchain.pem \
       --region "$REGION" >/dev/null 2>&1 &&
     aws ssm get-parameter --name "${application_parameter_path}/PG_PROXY_TLS_KEY" \
       --with-decryption --query 'Parameter.Value' --output text \
       --region "$REGION" > /etc/sproutos/pg-tls-privkey.pem 2>/dev/null &&
     [ -s /etc/sproutos/pg-tls-privkey.pem ]; then

    chmod 0600 /etc/sproutos/pg-tls-fullchain.pem /etc/sproutos/pg-tls-privkey.pem

    # An expired certificate is refused by every client, so an instance that booted with one is a
    # Postgres port that has silently stopped accepting `sslmode=require` — which looks like a
    # broken proxy and is a lapsed renewal. Kafka's certificate expired and went unnoticed for a
    # month precisely because nothing checked; this is the check.
    if openssl x509 -in /etc/sproutos/pg-tls-fullchain.pem -noout -checkend 0 >/dev/null 2>&1; then
      install -d -m 0755 /etc/systemd/system/sproutos.service.d
      # `LoadCredential` rather than a readable file: the unit runs as a `DynamicUser` with a uid
      # allocated at start, so there is nothing to chown the key to. systemd reads it as root and
      # drops a copy into a per-service directory only that uid can open.
      cat > /etc/systemd/system/sproutos.service.d/pg-tls.conf <<'PGTLS'
[Service]
LoadCredential=pg-tls-cert:/etc/sproutos/pg-tls-fullchain.pem
LoadCredential=pg-tls-key:/etc/sproutos/pg-tls-privkey.pem
Environment=PG_PROXY_TLS_CERT_FILE=%d/pg-tls-cert
Environment=PG_PROXY_TLS_KEY_FILE=%d/pg-tls-key
PGTLS
      echo "postgres TLS enabled, expires $(openssl x509 -in /etc/sproutos/pg-tls-fullchain.pem -noout -enddate)"
    else
      # Left unset rather than failing the boot. A lapsed certificate should cost `sslmode=require`,
      # not the whole front door.
      echo "postgres TLS certificate has expired; serving the port without TLS" >&2
      rm -f /etc/sproutos/pg-tls-fullchain.pem /etc/sproutos/pg-tls-privkey.pem
    fi
  else
    rm -f /etc/sproutos/pg-tls-fullchain.pem /etc/sproutos/pg-tls-privkey.pem
    echo "no postgres TLS material; the port will answer N to SSLRequest" >&2
  fi
fi


# The application's own secrets, from one Parameter Store path — see `app-secrets.tf` for why this
# is Parameter Store and not Secrets Manager.
#
# Takes the keys to write, because the two services do not need the same ones. The website is the
# only thing that talks to GitHub and Stripe; the router only needs what it verifies log tokens and
# reaches Kafka with. One instance role covers both, so this is not a privilege boundary — but a
# credential that is never written to a host is a credential that cannot leak from it, and the
# narrower list costs nothing.
#
# Without these the site boots, serves its landing page, and answers 500 on the first request that
# needs one — "Missing required environment variable: GITHUB_OAUTH_CLIENT_ID" from the login route,
# which is a failure a health check on `/healthz` cannot see because the process is fine.
#
# `get-parameters-by-path` returns at most ten parameters per page, and there are more than ten. The
# AWS CLI follows `NextToken` by itself, so this one call really does return all of them — but that
# is the CLI's doing, not the API's: `--no-paginate` here, or the same call from an SDK without a
# paginator, would silently deliver the first ten and the rest would surface as a 500 from whichever
# route happened to need the eleventh.
write_app_secrets() {
  WANTED="$1"
  APP_PARAMS=$(aws ssm get-parameters-by-path \
    --path "${application_parameter_path}" --recursive --with-decryption \
    --query 'Parameters[].[Name,Value]' --output json --region "$REGION")

  WANTED="$WANTED" python3 - "${application_parameter_path}" "$APP_PARAMS" >> /etc/sproutos/env <<'PYTHON'
import json, os, sys

prefix = sys.argv[1].rstrip("/") + "/"
wanted = os.environ["WANTED"].split()

for name, value in json.loads(sys.argv[2]):
    key = name[len(prefix):] if name.startswith(prefix) else name.rsplit("/", 1)[-1]
    if wanted and key not in wanted:
        continue
    # Single-quoted, with newlines escaped rather than written through.
    #
    # systemd's `EnvironmentFile` has no line continuation: a real newline in a value ends the
    # assignment, so a PEM would arrive as its first line and OpenSSL would report
    # "DECODER routines::unsupported" from inside a signing call ten frames down.
    # `githubAppConfigFromEnv` accepts the `\n`-escaped form and un-escapes it, which is the same
    # shape a PEM takes in a single-line `.env` — so this is the format the application already
    # expects rather than a workaround invented here.
    #
    # The quotes are what make that unambiguous. systemd parses unquoted and double-quoted values
    # with shell-like rules and interprets backslash escapes in them, so a bare `\n` would be turned
    # back into the newline this is trying to avoid. Inside single quotes nothing is interpreted, so
    # the two characters arrive as two characters. Only the newline is escaped and backslashes are
    # left alone, because `replaceAll("\\n", "\n")` on the reading side is exactly that one
    # substitution and nothing else.
    #
    # A value containing a single quote cannot be written this way and is refused rather than
    # silently mangled. None of the credentials this carries has one.
    if "'" in value:
        raise SystemExit(f"{key} contains a single quote, which cannot be written to the env file")
    print(f"{key}='" + value.replace("\n", "\\n") + "'")
PYTHON
}

# The website and API talk to GitHub, Stripe and the signer, and publish the log token onto every
# tenant Lambda. An empty list would mean "everything under the path", which is what this used to
# do; naming them means a key added for some future service does not silently appear here too.
if [ "$SERVICE" = "website" ]; then
  write_app_secrets "GITHUB_OAUTH_CLIENT_ID GITHUB_OAUTH_CLIENT_SECRET GITHUB_APP_ID \
    GITHUB_APP_CLIENT_ID GITHUB_APP_CLIENT_SECRET GITHUB_APP_PRIVATE_KEY GITHUB_WEBHOOK_SECRET \
    STRIPE_PUBLIC_KEY STRIPE_SECRET_KEY STRIPE_WEBHOOK_SECRET APK_SIGNER_TOKEN \
    DEPLOY_TOKEN_SECRET LOG_TOKEN_SECRET SPROUTOS_LOG_ENDPOINT \
    CLICKHOUSE_PASSWORD METERING_INGEST_HMAC_KEY LOG_EXTENSION_LAYER_ARN \
    KAFKA_BROKERS KAFKA_USAGE_EVENT_SASL_USERNAME KAFKA_USAGE_EVENT_SASL_PASSWORD \
    DAYTONA_API_KEY DAYTONA_ORGANIZATION_ID \
    SANDBOX_DAYTONA_SNAPSHOT SANDBOX_DAYTONA_API_URL \
    SANDBOX_DAYTONA_TARGET SANDBOX_FORWARD_PROXY_ROOT_KEY LLM_PROXY_SECRET \
    SEARCH_ADMIN_USER SEARCH_ADMIN_PASSWORD NEON_API_KEY NEON_ORG_ID \
    SERVICE_VALKEY_ADMIN_URL SEARCH_PROXY_SECURITY_ROOT_KEY VALKEY_PROXY_ACL_ROOT_KEY \
    SERVICE_OBJECT_STORAGE_ROOT_KEY"
fi

# The router verifies the per-project log token the extension presents and holds the Kafka
# connection open. `LOG_TOKEN_SECRET` has to be the *same* value the website stamps onto tenant
# functions — the router recomputes the token from it, so a mismatch rejects every log line with a
# 401 and the pipeline goes quiet without erroring anywhere a person would look.
if [ "$SERVICE" = "router" ]; then
  # `VALKEY_PROXY_BACKEND` is `rediss://` to the queue on the OVH box, which terminates its own TLS
  # and requires a password. It was withheld until that was true: the split starts when this is set
  # and `CredentialStore::check()` is fatal at boot, so naming a backend that cannot be reached does
  # not disable a feature — it stops the router, which is the front door.
  write_app_secrets "LLM_PROXY_SECRET OPENAI_KEY METERING_INGEST_HMAC_KEY LOG_TOKEN_SECRET KAFKA_BROKERS KAFKA_SASL_USERNAME KAFKA_SASL_PASSWORD \
    SEARCH_PROXY_SECURITY_ROOT_KEY VALKEY_PROXY_BACKEND VALKEY_PROXY_ACL_ROOT_KEY \
    SANDBOX_FORWARD_PROXY_ROOT_KEY SERVICE_OBJECT_STORAGE_ROOT_KEY"
fi

chmod 0640 /etc/sproutos/env

cat > /etc/systemd/system/sproutos.service <<'UNIT'
[Unit]
Description=SproutOS service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/sproutos/env
ExecStart=/opt/sproutos/start
Restart=always
RestartSec=2

# The service is the only thing on the box that matters, and it is reachable from the internet
# through the ALB. None of these cost anything and each removes a way a compromise becomes
# persistence.
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# A home directory, because a dynamic user does not have one and something in the bundle wants one.
#
# `DynamicUser` allocates a uid with no passwd entry and `ProtectHome` hides /home and /root, so
# `os.homedir()` fails outright — `uv_os_homedir returned ENOENT` — and it is called at *import*
# time by the Claude agent SDK, which esbuild inlines into the API bundle. The process dies before
# any of its own code runs, and the message names neither the SDK nor the sandboxing.
#
# `StateDirectory` is the right answer rather than `HOME=/tmp`: systemd creates it, chowns it to the
# dynamic uid and keeps it across restarts, so anything that writes a cache there is not writing to
# a directory that vanishes.
StateDirectory=sproutos
Environment=HOME=/var/lib/sproutos

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now sproutos.service

# Fail the instance rather than let it join the target group dead. The ALB would work this out from
# its health checks in about forty-five seconds; exiting non-zero here means the Auto Scaling group
# replaces it instead of leaving a permanently unhealthy instance in the rotation.
for _ in $(seq 1 30); do
  if curl -fsS "http://127.0.0.1:8080/healthz" >/dev/null 2>&1; then
    echo "$SERVICE is serving release $RELEASE"
    exit 0
  fi
  sleep 2
done

echo "$SERVICE did not answer /healthz within 60s" >&2
exit 1
