# github/gitignore's Terraform.gitignore, plus this directory's own build output.
#
# The root .gitignore already covers most of it. Keeping the canonical list here as well means a
# rule is not silently lost the day somebody reorganises the root file — and a leaked `.tfstate` is
# every secret this estate holds, in plaintext, in git history.

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Saved plans. A plan file contains every value the plan resolved, which includes secrets.
*.tfplan

# The placeholder zip built for a Lambda at plan time.
.build/
