{
  "name": "@sproutos/sprout-node",
  "version": "0.1.0",
  "private": true,
  "license": "BSD-3-Clause",
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "loader.cjs",
    "loader.d.cts",
    "*.node"
  ],
  "type": "module",
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./loader": {
      "types": "./loader.d.cts",
      "require": "./loader.cjs"
    }
  },
  "scripts": {
    "build": "napi build --release --platform --no-js --dts native.d.ts",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test:native": "node smoke.cjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.8.6",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "napi": {
    "binaryName": "sprout-node",
    "targets": [
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin"
    ]
  }
}
