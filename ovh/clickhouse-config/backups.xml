<clickhouse>
  <!--
    A named native-backup disk keeps credentials out of BACKUP statements and query_log. The
    endpoint includes the bucket and `clickhouse/` prefix; IAM independently confines this user to
    that same prefix. `from_env` means the secret is supplied only by the protected OVH host.
  -->
  <storage_configuration>
    <disks>
      <metering_backups>
        <type>s3</type>
        <endpoint from_env="CLICKHOUSE_BACKUP_S3_ENDPOINT" />
        <access_key_id from_env="CLICKHOUSE_BACKUP_S3_ACCESS_KEY_ID" />
        <secret_access_key from_env="CLICKHOUSE_BACKUP_S3_SECRET_ACCESS_KEY" />
      </metering_backups>
    </disks>
  </storage_configuration>
  <backups>
    <allowed_disk>metering_backups</allowed_disk>
    <allowed_path>/</allowed_path>
  </backups>
</clickhouse>
