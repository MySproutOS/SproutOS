# --- Core -------------------------------------------------------------------
# NODE_ENV deliberately absent.
#
# It was here as `NODE_ENV=development`, and because both SPAs point `envDir` at this file, Vite
# honoured it over its own `--mode production`: `isProduction` resolved false for every production
# build, so `@vitejs/plugin-react` emitted the *development* JSX transform (`jsxDEV`) and React
# loaded its development build. 222 KB of extra bundle, dev-only warnings shipped to users, and —
# once the runtime was correctly told it was production — a white screen, because
# `react/jsx-dev-runtime` has no `jsxDEV` in its production entry.
#
# Nothing needs it here. `apps/internal-api` sets it in its own `dev` script, Next.js sets it, and
# vitest sets `test`. A value in this file only ever overrides a tool that already knew better.
# The SPA configs now refuse a production build that is not production, so this cannot come back
# quietly.
DATABASE_URL=postgresql://postgres:postgres@localhost:25281/main?schema=public
# The platform's own Valkey — ElastiCache in production. Holds the hostname to
# Lambda route map the Rust router reads on every request, the billing counters,
# and the router's internal queue. Not the one tenant queues live on; see
# SERVICE_VALKEY_ADMIN_URL below.
VALKEY_URL=redis://localhost:41023

# Origin the browser apps are served from. Also the source of the session
# cookie's Domain flag and the API's CORS allowlist, so in production this must
# be the real site URL.
NEXT_PUBLIC_HOST_URL=http://localhost:3000

# Where the Vite SPAs send a browser when they have to leave themselves — signing in,
# landing on the dashboard after impersonation. The same origin as NEXT_PUBLIC_HOST_URL,
# under a second name because `NEXT_PUBLIC_` is Next.js's convention and Vite only exposes
# `VITE_`. Both SPAs read this file directly, via `envDir` in their Vite configs.
VITE_NEXTJS_URL=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:3001

# Port for the standalone Hono API in `pnpm run dev`
# (website 3000, dashboard 3002, admin 3003)
API_PORT=3001

# --- AWS / LocalStack -------------------------------------------------------
# Unset AWS_ENDPOINT_URL in production so the SDK talks to real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
# Used to reconstruct a live Lambda alias when the router reads through on a route-cache miss.
AWS_ACCOUNT_ID=000000000000
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# LocalStack only reads LOCALSTACK_AUTH_TOKEN. LOCALSTACK_PAT is silently ignored.
LOCALSTACK_AUTH_TOKEN=
# Envelope-encryption CMK, created by `bin/bootstrap-localstack.sh`.
KMS_KEY_ID=alias/sproutos-dev

# --- GitHub -----------------------------------------------------------------
# OAuth App: identity + user-initiated repo create/fork/delete.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Separate web OAuth client. Use the production client for localhost too; both callback URLs must
# be registered with the provider so the same local flow exercises the same credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GitHub App: headless upkeep, higher rate limits, short-lived install tokens.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Stripe -----------------------------------------------------------------
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Metering ---------------------------------------------------------------
METERING_INGEST_HMAC_KEY=

# --- Tenant queues (TASK 20, TASK 35) ---------------------------------------
# The shared Valkey that tenant queues live on, and how the control plane
# reaches it. This is deliberately NOT `VALKEY_URL` above: that one is the
# control plane's own cache, and pointing job inspection at it in production
# would have the API looking for a customer's jobs in the wrong instance.
#
# The control plane connects *directly* and applies the tenant's key namespace
# itself. It cannot go through valkey-proxy even in principle — a tenant's
# secret is stored as a one-way hash, so there is nothing to authenticate with.
SERVICE_VALKEY_ADMIN_URL=redis://localhost:41023
# Root for deterministic per-tenant backend ACL passwords. The router needs this; tenants never do.
VALKEY_PROXY_ACL_ROOT_KEY=replace-with-a-long-random-value
# Warning only. Raise this only after recording a representative engine measurement in ADR 0029.
VALKEY_ACL_CARDINALITY_SOFT_LIMIT=1000
# What goes in a customer's connection URI: the proxy, never the Valkey behind
# it. `redis` locally because nothing terminates TLS in development.
SERVICE_VALKEY_PUBLIC_HOST=localhost
SERVICE_VALKEY_PUBLIC_PORT=6380
SERVICE_VALKEY_SCHEME=redis

# --- Postgres, as a backend service (TASKS 25, 37) ---------------------------
# Where the control plane provisions a tenant's database and role. The compose
# Postgres is both the control plane's own database and the tenant cluster in
# development; in production these are two different servers, and confusing them
# would route a customer into the table holding every customer's billing.
SERVICE_POSTGRES_ADMIN_URL=postgresql://postgres:postgres@localhost:25281/main?schema=public
# What goes in a customer's connection URI: pg-proxy, never the cluster behind
# it. The proxy is what identifies the tenant, routes into their database, and
# drops its own privilege with `SET ROLE` before splicing the session — a URI
# naming the admin host above skips all of that.
#
# **These were missing entirely**, while the Valkey and search equivalents below
# were present, so `@lib/services`'s Postgres suite refused to start and its
# eighteen tests had never run outside CI. The driver is right to refuse rather
# than fall back; the configuration it refuses without simply did not exist.
SERVICE_POSTGRES_PUBLIC_HOST=localhost
SERVICE_POSTGRES_PUBLIC_PORT=5433
SERVICE_POSTGRES_SSLMODE=disable

# --- Object storage, as a backend service ------------------------------------
# S3-compatible. `obsidian-livesync` replicates against a bucket, and a bucket
# is nobody's server to run.
#
# Where the buckets actually live. LocalStack locally; on AWS this is unset and
# the SDK derives the endpoint from the region. **A customer is never given this
# address** — see the public endpoint below.
SERVICE_OBJECT_STORAGE_REGION=us-east-1
SERVICE_OBJECT_STORAGE_ENDPOINT=http://localhost:4566
# What a customer's client connects to: `services/storage-proxy`, which verifies
# their SigV4 signature, checks the bucket in the path is theirs, and re-signs
# with the platform's own credential. It has no default on purpose — pointing a
# customer at the bucket itself would hand them a key AWS has never heard of,
# and the failure reads as a wrong password rather than a misconfiguration.
SERVICE_OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9002
# Every tenant's S3 secret is derived from this with HMAC-SHA256, so nothing
# reversible is stored in `service_credential` and a database leak yields
# nothing replayable. Shared with the proxy and nothing else. Rotating it
# invalidates every customer's saved key at once, so it is not a routine act.
SERVICE_OBJECT_STORAGE_ROOT_KEY=dev-object-storage-root-key-not-for-production
# `endpoint/bucket` rather than `bucket.endpoint`. Always true against the
# proxy: it is one hostname serving every tenant, and virtual-host style would
# ask the resolver for a per-tenant name nobody created. The value is also what
# the customer sets as `force_path_style` in the plugin.
SERVICE_OBJECT_STORAGE_PATH_STYLE=true

# Where the proxy listens and what it forwards to. Only the proxy reads these.
STORAGE_PROXY_LISTEN=127.0.0.1:9002
STORAGE_PROXY_UPSTREAM=http://localhost:4566

# --- Observability (TASK 34) -------------------------------------------------
# The log store. `docker compose up -d clickhouse` gives you this one.
# Locally the compose ClickHouse. In production `https://clickhouse.sproutos.me`, which is the OVH
# box behind its Traefik — the API reads customers' runtime logs from there for the log viewer, and
# a localhost value in a deployed environment means that endpoint reports the store as unconfigured.
CLICKHOUSE_URL=http://localhost:28123
CLICKHOUSE_DATABASE=observability
CLICKHOUSE_USER=sproutos
CLICKHOUSE_PASSWORD=sproutos

# --- Tenant search (TASK 33) --------------------------------------------------
# The shared OpenSearch cluster, and how a tenant reaches it. `SEARCH_PROXY_*`
# is the proxy's own configuration; `SERVICE_SEARCH_*` is what goes into the
# connection URI handed to a customer — the proxy, never the cluster behind it.
SEARCH_PROXY_UPSTREAM=http://localhost:29200
SEARCH_PROXY_LISTEN=127.0.0.1:9201
# Required even locally: HMAC-derives the internal OpenSearch password the tenant never sees.
SEARCH_PROXY_SECURITY_ROOT_KEY=local-search-security-root-key-32-bytes
SEARCH_METERING_SPOOL_DIR=.data/search-metering
# Warning only. Raise this only after recording a higher secured-cluster measurement in ADR 0029.
SEARCH_SECURITY_CARDINALITY_SOFT_LIMIT=1000
SERVICE_SEARCH_PUBLIC_HOST=localhost
SERVICE_SEARCH_PUBLIC_PORT=9201
SERVICE_SEARCH_SCHEME=http

# --- Sandbox authenticated forward proxy -----------------------------------
FORWARD_PROXY_LISTEN=127.0.0.1:3128
# Opt-in Rust TLS edge. Leave ROUTER_TLS_EDGE_LISTEN unset to preserve the existing ALB/NLB paths.
# The certificate must cover every comma-separated exact name or one-label wildcard listed here.
# ROUTER_TLS_EDGE_LISTEN=127.0.0.1:8443
# ROUTER_HTTP_EDGE_LISTEN=127.0.0.1:8081
# ROUTER_TLS_EDGE_CERT_FILE=/path/to/fullchain.pem
# ROUTER_TLS_EDGE_KEY_FILE=/path/to/private-key.pem
# ROUTER_TLS_EDGE_SNI_NAMES=sproutos.run,*.sproutos.run,egress.sproutos.me
# ROUTER_TLS_EDGE_EGRESS_SNI=egress.sproutos.me
# Opaque S3 VersionId of the platform-edge object extracted into the two PEM files above.
# ROUTER_TLS_EDGE_PLATFORM_CERT_VERSION=example-version-id
# ROUTER_TLS_EDGE_MAX_CONNECTIONS=1024
# ROUTER_CERTIFICATE_BUCKET=sproutos-custom-certificates
# ROUTER_INSTANCE_ID=i-0123456789abcdef0
# ROUTER_CERTIFICATE_POLL_SECONDS=30
# ROUTER_CERTIFICATE_ACK_TTL_SECONDS=90

# ACME certificate reconciliation runs in the background worker. The account-key secret is shared
# by exact custom domains (HTTP-01) and the platform apex/wildcard/egress certificate (DNS-01).
# ACME_ACCOUNT_KEY_SECRET_ID=sproutos-acme-account-key
# ACME_CONTACT_EMAIL=ops@example.com
# ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
# TENANT_CERTIFICATE_BUCKET=sproutos-tenant-certificates
# TENANT_CERTIFICATE_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/example
# PLATFORM_EDGE_EGRESS_HOSTNAME=egress.sproutos.me
# PLATFORM_ACME_TENANT_ZONE_ID=Z123TENANT
# PLATFORM_ACME_EGRESS_ZONE_ID=Z123MAIN
# PLATFORM_ROUTER_ASG_NAMES=sproutos-router-blue,sproutos-router-green
# Required staging interlock: 0 permits issuance/storage but never restarts live router ASGs.
# PLATFORM_EDGE_ROLLOUT_ENABLED=0
# PLATFORM_CERTIFICATE_OBJECT_KEY=platform-edge/current.json

# The cluster as an administrator reaches it, bypassing the proxy. Only one caller
# uses this — the reaper that deletes a destroyed service's indices — and it is the
# one caller that legitimately names every tenant's indices at once.
SEARCH_ADMIN_URL=http://localhost:29200
SEARCH_ADMIN_USER=admin
SEARCH_ADMIN_PASSWORD=L0cal!Windmill-Quartz-83

# --- Self-hosted Neon (ADR 0025) ---------------------------------------------
# The storage controller. Every tenant operation goes through it — it is what
# knows which pageserver holds what — and never straight to a pageserver.
NEON_CONTROLLER_URL=http://127.0.0.1:21234
NEON_PG_VERSION=16
# `neon` routes new Postgres services to the self-hosted Neon storage layer;
# anything else keeps the `sprout` provider. Not per-service: the difference is
# what a database *is*, and a platform running both for one customer would have
# two meanings for "branch". ADR 0025.
SERVICE_POSTGRES_PROVIDER=sprout
# The administrative password every Neon compute is started with, shared with
# pg-proxy. A compute's pg_hba trusts only loopback *inside* the container, so
# any caller reaching it over the network — which is every real one — needs
# this. Not a per-compute secret: that would be a per-connection lookup for a
# credential that never leaves the platform.
NEON_COMPUTE_ADMIN_PASSWORD=dev-neon-compute-admin-not-for-production

# --- Neon (Agent plan) -------------------------------------------------------
# Org-wide API key for the control plane: creating projects, branches and
# endpoints, and reading the Consumption API for billing. Admin-level over
# every project in the org, so it belongs nowhere a customer's code can reach.
# ADR 0025.
NEON_API_KEY=napi_replace_me
NEON_ORG_ID=org-jolly-glitter-02122934
NEON_API_URL=https://console.neon.tech/api/v2

# --- The OVH host ------------------------------------------------------------
# Tenant search, tenant queues, and the log pipeline. Postgres is Neon's, in AWS.
OVH_HOST=
OVH_SSH_KEY=
OVH_CLICKHOUSE_USER=sproutos
OVH_CLICKHOUSE_PASSWORD=

# Where pg-proxy asks which database to connect onward to for a tenant. Unset
# means every connection goes to the shared cluster below, which is what keeps
# `provider = 'sprout'` databases working while `neon` is rolled out.
PG_PROXY_RESOLVE_URL=http://127.0.0.1:3001/v1/internal/pg/resolve

# Signs short-lived deploy tokens issued to GitHub Actions after an OIDC exchange.
DEPLOY_TOKEN_SECRET=
SERVICE_BUILD_BUCKET=sproutos-dev-artifacts

# The credential the on-premises Android signer presents. SproutOS never holds the signing key
# itself — a machine behind somebody's firewall does, and it polls /v1/apk-signing/claim over the
# public internet, so this is a real credential and not a network-position assumption. Unset means
# every signer is refused, which is the correct default for a deployment that has no signer.
APK_SIGNER_TOKEN=""

# Separate credential and fixed audit identity for the human-controlled catalogue-client identity
# and release commands. These must never equal APK_SIGNER_TOKEN; equality makes both credentials
# fail closed. The long-running on-prem signer service must not receive the operator credential.
APK_SIGNER_OPERATOR_TOKEN=""

# Server-to-server verification only. The background worker uses this restricted Google API key
# with the Android Developer ID Status API after the on-prem signer has produced a certificate.
# It does not authorize Android Developer Console mutations or replace the operator OAuth grant.
ANDROID_DEVELOPER_ID_STATUS_API_KEY=""

# The execution role every customer Lambda assumes. One role for all of them, not
# one per tenant: IAM roles are an account quota, so a role per project caps the
# platform at a few thousand customers and puts the tenant boundary in a policy
# document nothing here can test. The boundary is the function. `tofu output
# lambda_execution_role_arn`.
LAMBDA_EXECUTION_ROLE_ARN=

# The domain tenant applications are served on. Single-label hosts under it, so
# one ACM wildcard covers every project.
TENANT_DOMAIN=sproutos.me

# --- Runtime logs ------------------------------------------------------------
# Kafka is the buffer between whatever collects a customer's Lambda output and
# ClickHouse. Not decoration: inserting straight into ClickHouse gives one small
# INSERT per batch — its worst write pattern — with nowhere to put the lines when
# the link blips and no way to replay after a parsing bug.
#
# `kafka:9092` from inside the compose network, `localhost:29092` from the host.
# One listener cannot be both, which is why the broker advertises two.
KAFKA_BROKERS=kafka:9092
KAFKA_BROKERS_HOST=localhost:29092
KAFKA_RUNTIME_LOG_TOPIC=runtime-logs
# Raw, validated metering events. Kept separate from logs because a log can be dropped under
# pressure; acknowledging a usage event before Kafka has replicated it loses billable history.
# Producers and ClickHouse both default to this name so a rename cannot split the pipeline.
KAFKA_USAGE_EVENT_TOPIC=usage-events
# Must match the topic's real partition count. The log extension hashes a project onto one of these
# and asks for it by number, so a value larger than the topic has is a set of projects whose logs
# never arrive and nothing that says so.
KAFKA_RUNTIME_LOG_PARTITIONS=3

# The secret that signs the token proving which project the log extension belongs to.
#
# The extension does **not** hold a Kafka credential any more. It used to, and that credential sat
# in every customer function's environment where the customer's own code could read it — authorized
# to write a topic every tenant shares, on a broker that cannot restrict a message by its contents.
# Anyone holding it could publish records carrying another tenant's project_id, and those records
# carry billed_ms.
#
# Now the extension posts through the deployment's own generated tenant hostname, which always
# reaches the router. The endpoint is derived at publish time rather than configured here. The
# router owns the one Kafka connection and stamps the project from a token that says only "this is
# project X". LOG_TOKEN_SECRET signs those tokens here and services/router/src/log_token.rs verifies
# them.
LOG_TOKEN_SECRET=

# What the *router* authenticates to Kafka with. Only the router, and only in production.
#
# Locally, Kafka is on the Docker network with no authentication and these stay empty. In
# production the extension runs inside customers' Lambda execution environments in AWS and reaches
# the OVH broker across the public internet (ADR 0026), so the connection is TLS to
# `kafka.sproutos.me` — the name on its certificate — with SASL/SCRAM-SHA-512 on top.
#
# Not a secret in the sense of a password to a system: it is authorized to `Write` and `Describe`
# exactly one topic and can do nothing else, which is deliberate, because Lambda writes it onto
# every customer function's configuration where anyone who can read that configuration can read it.
# The ACL is the boundary; see `ovh/docker-compose.yaml`.
#
# Empty username means no SASL and no TLS — both or neither, since SCRAM over a plain socket has
# none of the guarantees that make it worth choosing.
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# The API's producer for raw billing events. A separate principal from runtime logs: each
# credential may Describe and Write exactly one topic, so compromising one pipeline cannot forge
# rows in the other.
KAFKA_USAGE_EVENT_SASL_USERNAME=
KAFKA_USAGE_EVENT_SASL_PASSWORD=

# Hourly ClickHouse-to-Valkey active-usage reconciliation limits. These are hard operational
# bounds: exceeding one fails the visible background job instead of turning an unexpected tenant
# cardinality into an unbounded ClickHouse query or Valkey cleanup pass.
ACTIVE_USAGE_MAX_ORGANIZATIONS=10000
ACTIVE_USAGE_MAX_EVENTS_PER_ORGANIZATION=100000
ACTIVE_USAGE_MAX_GENERATION_KEYS=250000
ACTIVE_USAGE_RECONCILIATION_PAGE_SIZE=500

# The deploy workflow records the repository-built layer here. Recording an ARN does not attach it:
# start with one comma-separated canary project, invoke and inspect it, then set the global switch.
# Both switches default off so an old parameter can never silently re-enable an old binary.
LOG_EXTENSION_LAYER_ARN=
LOG_EXTENSION_CANARY_PROJECT_IDS=
LOG_EXTENSION_ENABLED=false

# Which Lambda Web Adapter layer version customer web servers are published with. 29 is 1.1.0.
# Unset locally: nothing here publishes a Lambda.
LAMBDA_WEB_ADAPTER_LAYER_VERSION=

# Daytona runs every coding sandbox. `SANDBOX_DAYTONA_SNAPSHOT` names the image
# carrying the agent binaries: a wrong one produces a sandbox that starts cleanly with no agent in
# it and reports no error at all.
DAYTONA_API_KEY=
DAYTONA_ORGANIZATION_ID=
SANDBOX_DAYTONA_SNAPSHOT=
SANDBOX_DAYTONA_API_URL=
SANDBOX_DAYTONA_TARGET=

# Daytona's create-time upstream proxy. There is intentionally no domain allowlist: authenticated
# live sandboxes may reach any public HTTP(S) destination, while the proxy rejects private and
# metadata addresses. The root is exactly 32 bytes in base64 and must match the router.
SANDBOX_FORWARD_PROXY_URL=https://egress.sproutos.me
SANDBOX_FORWARD_PROXY_ROOT_KEY=

# The key the control plane seals a sandbox's model credential under and the router's LLM proxy
# opens it with: 32 bytes, base64. Both halves must hold the same value — a mismatch fails every
# agent turn at authentication, and the fixtures in `@lib/proxy-secret` are what keep the two
# implementations from drifting.
LLM_PROXY_SECRET=

# Platform-credit model turns use this key inside the router only. Sandboxes receive a short-lived
# SproutOS proxy token, never this provider credential.
OPENAI_KEY=

# Where the LLM proxy answers, as seen from inside a Daytona sandbox.
LLM_PROXY_URL=https://llm.sproutos.me
METERING_INGEST_URL=http://localhost:3001/v1/internal/metering/events
