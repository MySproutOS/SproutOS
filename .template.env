# --- Core -------------------------------------------------------------------
# NODE_ENV deliberately absent.
#
# It was here as `NODE_ENV=development`, and because both SPAs point `envDir` at this file, Vite
# honoured it over its own `--mode production`: `isProduction` resolved false for every production
# build, so `@vitejs/plugin-react` emitted the *development* JSX transform (`jsxDEV`) and React
# loaded its development build. 222 KB of extra bundle, dev-only warnings shipped to users, and —
# once the runtime was correctly told it was production — a white screen, because
# `react/jsx-dev-runtime` has no `jsxDEV` in its production entry.
#
# Nothing needs it here. `apps/internal-api` sets it in its own `dev` script, Next.js sets it, and
# vitest sets `test`. A value in this file only ever overrides a tool that already knew better.
# The SPA configs now refuse a production build that is not production, so this cannot come back
# quietly.
DATABASE_URL=postgresql://postgres:postgres@localhost:25281/main?schema=public
VALKEY_URL=redis://localhost:41023

# Origin the browser apps are served from. Also the source of the session
# cookie's Domain flag and the API's CORS allowlist, so in production this must
# be the real site URL.
NEXT_PUBLIC_HOST_URL=http://localhost:3000

# Where the Vite SPAs send a browser when they have to leave themselves — signing in,
# landing on the dashboard after impersonation. The same origin as NEXT_PUBLIC_HOST_URL,
# under a second name because `NEXT_PUBLIC_` is Next.js's convention and Vite only exposes
# `VITE_`. Both SPAs read this file directly, via `envDir` in their Vite configs.
VITE_NEXTJS_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Port for the standalone Hono API in `pnpm run dev`
# (website 3000, dashboard 3002, admin 3003)
API_PORT=3001

# --- AWS / LocalStack -------------------------------------------------------
# Unset AWS_ENDPOINT_URL in production so the SDK talks to real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# LocalStack only reads LOCALSTACK_AUTH_TOKEN. LOCALSTACK_PAT is silently ignored.
LOCALSTACK_AUTH_TOKEN=
# Envelope-encryption CMK, created by `bin/bootstrap-localstack.sh`.
KMS_KEY_ID=alias/sproutos-dev

# --- GitHub -----------------------------------------------------------------
# OAuth App: identity + user-initiated repo create/fork/delete.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# GitHub App: headless upkeep, higher rate limits, short-lived install tokens.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Stripe -----------------------------------------------------------------
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Metering ---------------------------------------------------------------
METERING_INGEST_HMAC_KEY=

# --- Tenant queues (TASK 20, TASK 35) ---------------------------------------
# The shared Valkey that tenant queues live on, and how the control plane
# reaches it. This is deliberately NOT `VALKEY_URL` above: that one is the
# control plane's own cache, and pointing job inspection at it in production
# would have the API looking for a customer's jobs in the wrong instance.
#
# The control plane connects *directly* and applies the tenant's key namespace
# itself. It cannot go through valkey-proxy even in principle — a tenant's
# secret is stored as a one-way hash, so there is nothing to authenticate with.
SERVICE_VALKEY_ADMIN_URL=redis://localhost:41023
# What goes in a customer's connection URI: the proxy, never the Valkey behind
# it. `redis` locally because nothing terminates TLS in development.
SERVICE_VALKEY_PUBLIC_HOST=localhost
SERVICE_VALKEY_PUBLIC_PORT=6380
SERVICE_VALKEY_SCHEME=redis

# --- Postgres, as a backend service (TASKS 25, 37) ---------------------------
# Where the control plane provisions a tenant's database and role. The compose
# Postgres is both the control plane's own database and the tenant cluster in
# development; in production these are two different servers, and confusing them
# would route a customer into the table holding every customer's billing.
SERVICE_POSTGRES_ADMIN_URL=postgresql://postgres:postgres@localhost:25281/main?schema=public
# What goes in a customer's connection URI: pg-proxy, never the cluster behind
# it. The proxy is what identifies the tenant, routes into their database, and
# drops its own privilege with `SET ROLE` before splicing the session — a URI
# naming the admin host above skips all of that.
#
# **These were missing entirely**, while the Valkey and search equivalents below
# were present, so `@lib/services`'s Postgres suite refused to start and its
# eighteen tests had never run outside CI. The driver is right to refuse rather
# than fall back; the configuration it refuses without simply did not exist.
SERVICE_POSTGRES_PUBLIC_HOST=localhost
SERVICE_POSTGRES_PUBLIC_PORT=5433
SERVICE_POSTGRES_SSLMODE=disable

# --- Object storage, as a backend service ------------------------------------
# S3-compatible. `obsidian-livesync` replicates against a bucket, and a bucket
# is nobody's server to run.
#
# Where the buckets actually live. LocalStack locally; on AWS this is unset and
# the SDK derives the endpoint from the region. **A customer is never given this
# address** — see the public endpoint below.
SERVICE_OBJECT_STORAGE_REGION=us-east-1
SERVICE_OBJECT_STORAGE_ENDPOINT=http://localhost:4566
# What a customer's client connects to: `services/storage-proxy`, which verifies
# their SigV4 signature, checks the bucket in the path is theirs, and re-signs
# with the platform's own credential. It has no default on purpose — pointing a
# customer at the bucket itself would hand them a key AWS has never heard of,
# and the failure reads as a wrong password rather than a misconfiguration.
SERVICE_OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9002
# Every tenant's S3 secret is derived from this with HMAC-SHA256, so nothing
# reversible is stored in `service_credential` and a database leak yields
# nothing replayable. Shared with the proxy and nothing else. Rotating it
# invalidates every customer's saved key at once, so it is not a routine act.
SERVICE_OBJECT_STORAGE_ROOT_KEY=dev-object-storage-root-key-not-for-production
# `endpoint/bucket` rather than `bucket.endpoint`. Always true against the
# proxy: it is one hostname serving every tenant, and virtual-host style would
# ask the resolver for a per-tenant name nobody created. The value is also what
# the customer sets as `force_path_style` in the plugin.
SERVICE_OBJECT_STORAGE_PATH_STYLE=true

# Where the proxy listens and what it forwards to. Only the proxy reads these.
STORAGE_PROXY_LISTEN=127.0.0.1:9002
STORAGE_PROXY_UPSTREAM=http://localhost:4566

# --- Observability (TASK 34) -------------------------------------------------
# The log store. `docker compose up -d clickhouse` gives you this one.
CLICKHOUSE_URL=http://localhost:28123
CLICKHOUSE_DATABASE=observability
CLICKHOUSE_USER=sproutos
CLICKHOUSE_PASSWORD=sproutos

# --- Tenant search (TASK 33) --------------------------------------------------
# The shared OpenSearch cluster, and how a tenant reaches it. `SEARCH_PROXY_*`
# is the proxy's own configuration; `SERVICE_SEARCH_*` is what goes into the
# connection URI handed to a customer — the proxy, never the cluster behind it.
SEARCH_PROXY_UPSTREAM=http://localhost:29200
SEARCH_PROXY_LISTEN=127.0.0.1:9201
SERVICE_SEARCH_PUBLIC_HOST=localhost
SERVICE_SEARCH_PUBLIC_PORT=9201
SERVICE_SEARCH_SCHEME=http

# The cluster as an administrator reaches it, bypassing the proxy. Only one caller
# uses this — the reaper that deletes a destroyed service's indices — and it is the
# one caller that legitimately names every tenant's indices at once.
SEARCH_ADMIN_URL=http://localhost:29200

# --- Self-hosted Neon (ADR 0025) ---------------------------------------------
# The storage controller. Every tenant operation goes through it — it is what
# knows which pageserver holds what — and never straight to a pageserver.
NEON_CONTROLLER_URL=http://127.0.0.1:21234
NEON_PG_VERSION=16
# `neon` routes new Postgres services to the self-hosted Neon storage layer;
# anything else keeps the `sprout` provider. Not per-service: the difference is
# what a database *is*, and a platform running both for one customer would have
# two meanings for "branch". ADR 0025.
SERVICE_POSTGRES_PROVIDER=sprout
# The administrative password every Neon compute is started with, shared with
# pg-proxy. A compute's pg_hba trusts only loopback *inside* the container, so
# any caller reaching it over the network — which is every real one — needs
# this. Not a per-compute secret: that would be a per-connection lookup for a
# credential that never leaves the platform.
NEON_COMPUTE_ADMIN_PASSWORD=dev-neon-compute-admin-not-for-production
